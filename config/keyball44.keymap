#define DEFAULT 0
#define WINDOWS 1
#define NAV     2
#define NUMBERS 3
#define SYMBOL  4
#define CONTROL 5
#define SCROLL  6
#define SNIPE   7

#include <behaviors/mouse_keys.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/backlight.h>

/*
 * Run the nice!view on the nRF's NON-DMA SPI driver (nordic,nrf-spi) instead
 * of the default SPIM (nordic,nrf-spim, which uses EasyDMA). The display's SPIM
 * DMA transfers collided with the trackball's SPIM1 DMA -> silent nice!view
 * frame corruption (confirmed by logs; the old I2C OLED never did this because
 * I2C is a different engine). Non-DMA SPI clocks bytes out via the CPU (no
 * EasyDMA) so it can't contend -- and unlike bit-bang it supports the LSB-first
 * bit order the ls0xx requires. SPI0-2 on nRF52840 support non-DMA mode, and
 * the SPIM_* pinctrl from the nice_view_adapter is shared by both drivers.
 */
&spi0 { compatible = "nordic,nrf-spi"; };

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
    // Don't treat U/I/SPACE/Z as a layer-hold if you were just typing.
    // This is the main fix for dropped letters on fast rolls.
    require-prior-idle-ms = <150>;
};

&mt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
    quick-tap-ms = <150>;
    require-prior-idle-ms = <125>;
};

&caps_word { continue-list = <UNDERSCORE MINUS>; };

/ {
    combos {
        compatible = "zmk,combos";
        // NOTE: no require-prior-idle-ms here on purpose -- it made combos you
        // fire right after typing (e.g. ' = L+;) feel laggy. The 50ms two-key
        // window is the only guard. If a specific combo misfires mid-word,
        // add a SMALL require-prior-idle-ms (~40) to just that one.
        combo_esc {
            timeout-ms = <50>;
            key-positions = <2 3>;
            bindings = <&gresc>;
        };
        combo_tab {
            timeout-ms = <50>;
            key-positions = <14 15>;
            bindings = <&kp TAB>;
        };
        combo_quote {
            timeout-ms = <50>;
            key-positions = <21 22>;
            bindings = <&kp SQT>;
        };
        combo_left_click {
            timeout-ms = <50>;
            key-positions = <19 20>;
            bindings = <&mkp LCLK>;
        };
        combo_right_click {
            timeout-ms = <50>;
            key-positions = <20 21>;
            bindings = <&mkp RCLK>;
        };
        combo_symbol {
            timeout-ms = <50>;
            key-positions = <41 42>;
            bindings = <&mo SYMBOL>;
        };
        combo_minus {
            timeout-ms = <50>;
            key-positions = <9 10>;
            bindings = <&kp MINUS>;
        };
        combo_question {
            timeout-ms = <50>;
            key-positions = <28 29>;
            bindings = <&kp QUESTION>;
        };
    };

    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick_tap_ms = <150>;
            require-prior-idle-ms = <125>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        bkspc_shft: backspace_shift {
            compatible = "zmk,behavior-hold-tap";
            label = "BACKSPACE_SHIFT";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            require-prior-idle-ms = <125>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
        
        gresc: grave_escape {
            compatible = "zmk,behavior-mod-morph";
            label = "GRAVE_ESCAPE";
            #binding-cells = <0>;
            bindings = <&kp ESC>, <&kp GRAVE>;
            mods = <(MOD_LGUI|MOD_LSFT|MOD_RGUI|MOD_RSFT)>;
            keep-mods = <(MOD_LGUI|MOD_RGUI)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "DEFAULT";
            display-name = "Base";
            bindings = <
// Row 0 Left - 6 keys
&gresc          &kp Q      &kp W      &kp E      &kp R      &kp T
// Row 0 Right - 6 keys
&kp Y           &lt SNIPE U &lt SCROLL I &kp O      &kp P      &kp BSLH
// Row 1 Left - 6 keys
&kp CAPS        &kp A      &kp S      &kp D      &kp F      &kp G
// Row 1 Right - 6 keys
&kp H           &kp J      &kp K      &kp L      &kp SEMI   &kp SQT
// Row 2 Left - 6 keys
&kp LEFT_SHIFT  &lt CONTROL Z &hm LCTRL X &hm LALT C &hm LGUI V &kp B
// Row 2 Right - 6 keys
&kp N           &hm LGUI M &hm LALT COMMA &hm LCTRL DOT &kp SLASH  &kp RIGHT_SHIFT
// Row 3 - Thumb row (5 left + 3 right = 8 keys)
// Left thumb keys (5 keys): first was dead -> now caps_word
&none           &caps_word &hm LSHFT DEL &hm LGUI RET &mo NUMBERS
// Right thumb keys (3 keys)
&lt NAV SPACE    &bkspc_shft LSHFT BSPC &none
            >;
        };

        // Toggle (via CONTROL layer) that swaps GUI<->CTRL so the same fingers
        // that hit Cmd on macOS hit Ctrl on Windows/Linux. Everything else
        // falls through (&trans) to the base layer.
        windows {
            label = "WINDOWS";
            display-name = "Win";
            bindings = <
// Row 0 Left - 6 keys
&trans          &trans     &trans     &trans     &trans     &trans
// Row 0 Right - 6 keys
&trans          &trans     &trans     &trans     &trans     &trans
// Row 1 Left - 6 keys
&trans          &trans     &trans     &trans     &trans     &trans
// Row 1 Right - 6 keys
&trans          &trans     &trans     &trans     &trans     &trans
// Row 2 Left - 6 keys  (X: CTRL->GUI, V: GUI->CTRL)
&trans          &trans     &hm LGUI X &trans     &hm LCTRL V &trans
// Row 2 Right - 6 keys (M: GUI->CTRL, DOT: CTRL->GUI)
&trans          &hm LCTRL M &trans    &hm LGUI DOT &trans    &trans
// Row 3 - Thumb row (RET: GUI->CTRL)
&trans          &trans     &trans     &hm LCTRL RET &trans
&trans          &trans     &trans
            >;
        };

        nav {
            label = "NAV";
            display-name = "Nav";
            bindings = <
// Row 0 Left - 6 keys
&none           &none      &none      &none      &none      &kp C_VOL_UP
// Row 0 Right - 6 keys
&none           &none      &none      &none      &none      &none
// Row 1 Left - 6 keys
&none           &none      &none      &none      &none      &kp C_VOL_DN
// Row 1 Right - 6 keys
&kp LEFT        &kp DOWN   &kp UP     &kp RIGHT  &none      &none
// Row 2 Left - 6 keys
&none           &none      &none      &none      &none      &kp C_MUTE
// Row 2 Right - 6 keys
&kp LG(LBRC)    &kp LA(LS(DOWN)) &kp LA(LS(UP)) &kp LG(RBRC) &none &none
// Row 3 - Thumb row
&none           &none      &none      &none      &none
&none           &none      &none
            >;
        };

        numbers {
            label = "NUMBERS";
            display-name = "Num";
            bindings = <
// Row 0 Left - 6 keys
&kp F1          &kp F2     &kp F3     &kp F4     &kp F5     &kp F6
// Row 0 Right - 6 keys
&kp F7          &kp F8     &kp F9     &kp F10    &kp F11    &kp F12
// Row 1 Left - 6 keys
&none           &kp N1     &kp N2     &kp N3     &kp N4     &kp N5
// Row 1 Right - 6 keys
&kp N6          &kp N7     &kp N8     &kp N9     &kp N0     &none
// Row 2 Left - 6 keys
&none           &none      &none      &none      &none      &none
// Row 2 Right - 6 keys
&none           &none      &none      &none      &none      &none
// Row 3 - Thumb row
&trans          &trans     &trans     &trans     &trans
&trans          &trans     &trans
            >;
        };

        symbol {
            label = "SYMBOL";
            display-name = "Sym";
            bindings = <
// Row 0 Left - 6 keys
&none           &none      &none      &none      &none      &none
// Row 0 Right - 6 keys
&kp GRAVE       &kp EQUAL  &kp LBRC   &kp RBRC   &kp PIPE   &kp BSLH
// Row 1 Left - 6 keys
&none           &none      &none      &none      &none      &none
// Row 1 Right - 6 keys
&kp LBKT        &kp RBKT   &kp LPAR   &kp RPAR   &kp MINUS  &none
// Row 2 Left - 6 keys
&none           &none      &none      &none      &none      &none
// Row 2 Right - 6 keys
&none           &kp PLUS   &kp EQUAL  &kp LT     &kp GT     &kp FSLH
// Row 3 - Thumb row
&trans          &trans     &trans     &trans     &trans
&trans          &trans     &trans
            >;
        };

        CONTROL {
            label = "CONTROL";
            display-name = "Ctrl";
            bindings = <
// Row 0 Left - 6 keys
&bootloader     &none      &tog WINDOWS      &none      &none      &none
// Row 0 Right - 6 keys
&none           &none      &none      &none      &none      &bootloader
// Row 1 Left - 6 keys
&none           &none      &none      &none      &none      &none
// Row 1 Right - 6 keys
&none           &none      &none      &none      &none      &none
// Row 2 Left - 6 keys
&bt BT_CLR      &none      &none      &none      &none      &none
// Row 2 Right - 6 keys
&bt BT_SEL 0     &bt BT_PRV &bt BT_NXT &none &none &none
// Row 3 - Thumb row
&none           &none      &none      &none     &none
&none           &none      &none
            >;
        };

        scroll {
            label = "SCROLL";
            display-name = "Scroll";
            bindings = <
// Row 0 Left - 6 keys
&trans          &trans     &trans     &trans     &trans     &trans
// Row 0 Right - 6 keys
&trans          &trans     &trans     &trans     &trans     &trans
// Row 1 Left - 6 keys
&trans          &trans     &trans     &trans     &trans     &trans
// Row 1 Right - 6 keys
&trans          &trans     &trans     &trans     &trans     &trans
// Row 2 Left - 6 keys
&trans          &trans     &trans     &trans     &trans     &trans
// Row 2 Right - 6 keys
&trans          &trans     &trans     &trans     &trans     &trans
// Row 3 - Thumb row
&trans          &trans     &trans     &trans     &trans
&trans          &trans     &trans
            >;
        };

        snipe {
            label = "SNIPE";
            display-name = "Snipe";
            bindings = <
// Row 0 Left - 6 keys
&trans          &trans     &trans     &trans     &trans     &trans
// Row 0 Right - 6 keys
&trans          &trans     &trans     &trans     &trans     &trans
// Row 1 Left - 6 keys
&trans          &trans     &trans     &trans     &trans     &trans
// Row 1 Right - 6 keys
&trans          &trans     &trans     &trans     &trans     &trans
// Row 2 Left - 6 keys
&trans          &trans     &trans     &trans     &trans     &trans
// Row 2 Right - 6 keys
&trans          &trans     &trans     &trans     &trans     &trans
// Row 3 - Thumb row
&trans          &trans     &trans     &trans     &trans
&trans          &trans     &trans
            >;
        };
    };
};
