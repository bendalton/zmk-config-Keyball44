#define DEFAULT 0
#define WINDOWS 1
#define NAV     2
#define NUMBERS 3
#define SYMBOL  4
#define CONTROL 5
#define SCROLL  6
#define SNIPE   7

// &pwd params (see behaviors { pwd } below)
#define PWD_REC  0
#define PWD_PLAY 1
#define PWD_CLR  2

#include <behaviors/mouse_keys.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/backlight.h>

// nice!view CS override moved to keyball44_{left,right}.overlay so this keymap
// stays display-free and can be shared with the display-less dongle build.

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
    // Don't treat U/I/SPACE/Z as a layer-hold if you were just typing.
    // This is the main fix for dropped letters on fast rolls.
    require-prior-idle-ms = <150>;
};

&mt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
    quick-tap-ms = <150>;
    require-prior-idle-ms = <125>;
};

// continue-list REPLACES ZMK's default (UNDERSCORE BACKSPACE DELETE), so the
// defaults must be listed again or fixing a typo ends caps word.
&caps_word { continue-list = <UNDERSCORE MINUS BACKSPACE DELETE>; };

/ {
    combos {
        compatible = "zmk,combos";
        // NOTE: no require-prior-idle-ms here on purpose -- it made combos you
        // fire right after typing (e.g. ' = L+;) feel laggy. The 50ms two-key
        // window is the only guard. If a specific combo misfires mid-word,
        // add a SMALL require-prior-idle-ms (~40) to just that one.
        combo_esc {
            timeout-ms = <50>;
            key-positions = <2 3>;
            bindings = <&gresc>;
        };
        combo_tab {
            timeout-ms = <50>;
            key-positions = <14 15>;
            bindings = <&kp TAB>;
        };
        combo_quote {
            timeout-ms = <50>;
            key-positions = <21 22>;
            bindings = <&kp SQT>;
        };
        combo_left_click {
            timeout-ms = <50>;
            key-positions = <19 20>;
            bindings = <&mkp LCLK>;
        };
        combo_right_click {
            timeout-ms = <50>;
            key-positions = <20 21>;
            bindings = <&mkp RCLK>;
        };
        combo_symbol {
            timeout-ms = <50>;
            key-positions = <41 42>;
            bindings = <&mo SYMBOL>;
        };
        combo_minus {
            timeout-ms = <50>;
            key-positions = <9 10>;
            bindings = <&kp MINUS>;
        };
        // P+\ = pipe (next to the backslash key it shifts from).
        // Plus = ;+' (was I+O). Moved 2026-11-11 to test the random "iii"
        // repeats: I (&lt SCROLL I) was the only key that was BOTH a hold-tap
        // and a combo member, and that pairing is a known way for ZMK to
        // lose a key-up (host then auto-repeats). Keep hold-tap keys out of
        // combos. If the repeats continue, this wasn't it -- look at BLE.
        combo_plus {
            timeout-ms = <50>;
            key-positions = <22 23>;
            bindings = <&kp PLUS>;
        };
        combo_pipe {
            timeout-ms = <50>;
            key-positions = <10 11>;
            bindings = <&kp PIPE>;
        };
        // Left-hand space (D+F), one column over from S+D=tab. Lets you hit
        // space while the right thumb is busy holding NAV or the SYMBOL combo.
        // If it misfires on fast d->f rolls ("handful", "mindful"), add a
        // small require-prior-idle-ms (~40) to just this combo.
        // Hold Z or the rightmost thumb (CONTROL), then T+Y together =
        // dongle into flash mode.
        // Three keys across both hands on purpose: an accidental hit leaves
        // the keyboard dead until you flash or unplug the dongle.
        combo_dongle_boot {
            timeout-ms = <50>;
            key-positions = <5 6>;
            layers = <CONTROL>;
            bindings = <&dongle_boot>;
        };
        // Hold Z or the rightmost thumb (CONTROL), then:
        //   Esc + left Shift   (0+24)  = LEFT half into flash mode
        //   F18 + right Shift  (11+35) = RIGHT half into flash mode
        // Combos run on the dongle, so stock &bootloader would reboot the
        // dongle; &half_boot forwards it to the half that owns the position.
        // CONTROL-only, so Shift+Esc (~) on the base layer is untouched.
        combo_left_boot {
            timeout-ms = <50>;
            key-positions = <0 24>;
            layers = <CONTROL>;
            bindings = <&half_boot 24>;
        };
        combo_right_boot {
            timeout-ms = <50>;
            key-positions = <11 35>;
            layers = <CONTROL>;
            bindings = <&half_boot 35>;
        };
        combo_space {
            timeout-ms = <50>;
            key-positions = <15 16>;
            bindings = <&kp SPACE>;
        };
    };

    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <125>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        // Thumb mods: NO require-prior-idle-ms. Thumbs get pressed right after
        // typing/layer taps by design, so the "instant tap if recently typed"
        // rule that protects the finger home-row mods turns Cmd-holds into
        // stray Enters here. Balanced flavor so chording another key while
        // holding resolves as the modifier without waiting out the term.
        hmt: thumb_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "THUMB_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };

        bkspc_shft: backspace_shift {
            compatible = "zmk,behavior-hold-tap";
            label = "BACKSPACE_SHIFT";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
        
        // RAM-only password macro (src/behavior_ram_macro.c). PWD_REC, type
        // the password (it still reaches the host, so type it into the real
        // prompt), then Enter/Esc saves it -- the Enter/Esc itself is sent
        // but not stored. PWD_PLAY types it back. Lives only in the central's
        // RAM: gone on reset/power loss, never in flash or over split BLE.
        // 30s of no typing while recording aborts + wipes.
        pwd: password_macro {
            compatible = "zmk,behavior-ram-macro";
            #binding-cells = <1>;
            display-name = "Password Macro";
        };

        // Reboot the DONGLE into its UF2 bootloader (mounts as NICENANO), so
        // re-flashing it needs no RST-GND short. Stock &bootloader can't do
        // this: it reboots whichever half the key is on. See
        // src/behavior_central_bootloader.c. Bound to the CONTROL-layer T+Y
        // combo below.
        dongle_boot: dngboot {
            compatible = "zmk,behavior-central-reset";
            type = <RST_UF2>;
            #binding-cells = <0>;
            display-name = "Dongle Bootloader";
        };

        // Reboot one HALF into its UF2 bootloader from a combo. Param = a key
        // position on that half (src/behavior_half_bootloader.c).
        half_boot: half_bootloader {
            compatible = "zmk,behavior-half-bootloader";
            #binding-cells = <1>;
            display-name = "Half Bootloader";
        };

        gresc: grave_escape {
            compatible = "zmk,behavior-mod-morph";
            label = "GRAVE_ESCAPE";
            #binding-cells = <0>;
            bindings = <&kp ESC>, <&kp GRAVE>;
            mods = <(MOD_LGUI|MOD_LSFT|MOD_RGUI|MOD_RSFT)>;
            // Keep shift so shift+combo yields ~ (tilde), not a bare backtick.
            keep-mods = <(MOD_LGUI|MOD_RGUI|MOD_LSFT|MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "DEFAULT";
            display-name = "Base";
            bindings = <
// Row 0 Left - 6 keys
&gresc          &kp Q      &kp W      &kp E      &kp R      &kp T
// Row 0 Right - 6 keys
// Far-right key = F18, the meeting mute/push-to-talk key. Tap/hold logic and
// the actual mic muting live in Hammerspoon on the Mac (~/.hammerspoon), so it
// works in Meet/Teams/Zoom without focus. Backslash is still on SYMBOL, and
// the P+\ pipe combo still fires (it's by position).
&kp Y           &lt SNIPE U &lt SCROLL I &kp O      &kp P      &kp F18
// Row 1 Left - 6 keys
&kp CAPS        &kp A      &kp S      &kp D      &kp F      &kp G
// Row 1 Right - 6 keys
&kp H           &kp J      &kp K      &kp L      &kp SEMI   &kp SQT
// Row 2 Left - 6 keys
&kp LEFT_SHIFT  &lt CONTROL Z &hm LCTRL X &hm LALT C &hm LGUI V &kp B
// Row 2 Right - 6 keys
&kp N           &hm LGUI M &hm LALT COMMA &hm LCTRL DOT &kp SLASH  &kp RIGHT_SHIFT
// Row 3 - Thumb row (5 left + 3 right = 8 keys)
// Left thumb keys (5 keys): first was dead -> now caps_word
&none           &caps_word &hmt LSHFT DEL &hmt LGUI RET &mo NUMBERS
// Right thumb keys (3 keys)
// Rightmost thumb = hold for CONTROL (same as holding Z).
&lt NAV SPACE    &bkspc_shft LSHFT BSPC &mo CONTROL
            >;
        };

        // Toggle (via CONTROL layer) that swaps GUI<->CTRL so the same fingers
        // that hit Cmd on macOS hit Ctrl on Windows/Linux. Everything else
        // falls through (&trans) to the base layer.
        windows {
            label = "WINDOWS";
            display-name = "Win";
            bindings = <
// Row 0 Left - 6 keys
&trans          &trans     &trans     &trans     &trans     &trans
// Row 0 Right - 6 keys
&trans          &trans     &trans     &trans     &trans     &trans
// Row 1 Left - 6 keys
&trans          &trans     &trans     &trans     &trans     &trans
// Row 1 Right - 6 keys
&trans          &trans     &trans     &trans     &trans     &trans
// Row 2 Left - 6 keys  (X: CTRL->GUI, V: GUI->CTRL)
&trans          &trans     &hm LGUI X &trans     &hm LCTRL V &trans
// Row 2 Right - 6 keys (M: GUI->CTRL, DOT: CTRL->GUI)
&trans          &hm LCTRL M &trans    &hm LGUI DOT &trans    &trans
// Row 3 - Thumb row (RET: GUI->CTRL)
&trans          &trans     &trans     &hmt LCTRL RET &trans
&trans          &trans     &trans
            >;
        };

        nav {
            label = "NAV";
            display-name = "Nav";
            // Right hand: arrows on HJKL home row; the row above is the
            // "amplified" version of the arrow below it -- Y=word-left over
            // left, U=page-down over down, I=page-up over up, O=word-right
            // over right.
            // Left hand: plain mods on the SAME fingers as the base-layer
            // homerow mods (X=Ctrl, C=Opt, V=Cmd) plus pinky Shift, so
            // Space+C+H/L = word jump, Space+V+H/L = line start/end, and
            // adding pinky Shift turns any of it into selection.
            // S = screenshot (Cmd+Shift+5 -> CleanShot X).
            bindings = <
// Row 0 Left - 6 keys
&none           &none      &none      &none      &none      &kp C_VOL_UP
// Row 0 Right - 6 keys
&kp LA(LEFT)    &kp PG_DN  &kp PG_UP  &kp LA(RIGHT) &none   &none
// Row 1 Left - 6 keys
&none           &none      &kp LG(LS(N5)) &none  &none      &kp C_VOL_DN
// Row 1 Right - 6 keys
&kp LEFT        &kp DOWN   &kp UP     &kp RIGHT  &none      &none
// Row 2 Left - 6 keys
&kp LSHFT       &none      &kp LCTRL  &kp LALT   &kp LGUI   &kp C_MUTE
// Row 2 Right - 6 keys
&kp LG(LBRC)    &kp LA(LS(DOWN)) &kp LA(LS(UP)) &kp LG(RBRC) &none &none
// Row 3 - Thumb row: pass through, so Enter/Del work while holding NAV and
// holding the Del thumb (Shift) + HJKL selects.
&trans          &trans     &trans     &trans     &trans
&trans          &trans     &trans
            >;
        };

        numbers {
            label = "NUMBERS";
            display-name = "Num";
            bindings = <
// Row 0 Left - 6 keys
&kp F1          &kp F2     &kp F3     &kp F4     &kp F5     &kp F6
// Row 0 Right - 6 keys
&kp F7          &kp F8     &kp F9     &kp F10    &kp F11    &kp F12
// Row 1 Left - 6 keys
&none           &kp N1     &kp N2     &kp N3     &kp N4     &kp N5
// Row 1 Right - 6 keys
&kp N6          &kp N7     &kp N8     &kp N9     &kp N0     &none
// Row 2 Left - 6 keys
&none           &none      &none      &none      &none      &none
// Row 2 Right - 6 keys
&none           &none      &none      &none      &none      &none
// Row 3 - Thumb row
&trans          &trans     &trans     &trans     &trans
&trans          &trans     &trans
            >;
        };

        // Home row = the shifted number row of a normal keyboard, ~ through _.
        // Each symbol sits on the key its digit uses on NUMBERS (! on A = 1,
        // ( on L = 9). Bracket family stacked on L/; : { } above, ( ) home,
        // [ ] below. _ over - at the far right, like a real -/_ key.
        symbol {
            label = "SYMBOL";
            display-name = "Sym";
            bindings = <
// Row 0 Left - 6 keys
&none           &none      &none      &none      &none      &none
// Row 0 Right - 6 keys
&kp GRAVE       &kp EQUAL  &kp PLUS   &kp LBRC   &kp RBRC   &kp BSLH
// Row 1 Left - 6 keys
&kp TILDE       &kp EXCL   &kp AT     &kp HASH   &kp DLLR   &kp PRCNT
// Row 1 Right - 6 keys
&kp CARET       &kp AMPS   &kp STAR   &kp LPAR   &kp RPAR   &kp UNDER
// Row 2 Left - 6 keys
&none           &none      &none      &none      &none      &none
// Row 2 Right - 6 keys
&none           &kp PIPE   &none      &kp LBKT   &kp RBKT   &kp MINUS
// Row 3 - Thumb row
&trans          &trans     &trans     &trans     &trans
&trans          &trans     &trans
            >;
        };

        CONTROL {
            label = "CONTROL";
            display-name = "Ctrl";
            bindings = <
// Row 0 Left - 6 keys  (R = record password macro)
// (Esc alone no longer flashes: it's the Esc+LShift combo now.)
&none           &none      &tog WINDOWS      &none      &pwd PWD_REC &none
// Row 0 Right - 6 keys
// (Half flashing = CONTROL combos Esc+LShift / F18+RShift, see combos.)
&none           &none      &none      &none      &none      &none
// Row 1 Left - 6 keys
&none           &none      &none      &none      &none      &none
// Row 1 Right - 6 keys  (; = play password macro)
&none           &none      &none      &none      &pwd PWD_PLAY &none
// Row 2 Left - 6 keys
&bt BT_CLR      &none      &none      &none      &none      &none
// Row 2 Right - 6 keys
&bt BT_SEL 0     &bt BT_PRV &bt BT_NXT &none &none &none
// Row 3 - Thumb row
&none           &none      &none      &none     &none
&none           &none      &none
            >;
        };

        scroll {
            label = "SCROLL";
            display-name = "Scroll";
            bindings = <
// Row 0 Left - 6 keys
&trans          &trans     &trans     &trans     &trans     &trans
// Row 0 Right - 6 keys
&trans          &trans     &trans     &trans     &trans     &trans
// Row 1 Left - 6 keys
&trans          &trans     &trans     &trans     &trans     &trans
// Row 1 Right - 6 keys
&trans          &trans     &trans     &trans     &trans     &trans
// Row 2 Left - 6 keys
&trans          &trans     &trans     &trans     &trans     &trans
// Row 2 Right - 6 keys
&trans          &trans     &trans     &trans     &trans     &trans
// Row 3 - Thumb row
&trans          &trans     &trans     &trans     &trans
&trans          &trans     &trans
            >;
        };

        snipe {
            label = "SNIPE";
            display-name = "Snipe";
            bindings = <
// Row 0 Left - 6 keys
&trans          &trans     &trans     &trans     &trans     &trans
// Row 0 Right - 6 keys
&trans          &trans     &trans     &trans     &trans     &trans
// Row 1 Left - 6 keys
&trans          &trans     &trans     &trans     &trans     &trans
// Row 1 Right - 6 keys
&trans          &trans     &trans     &trans     &trans     &trans
// Row 2 Left - 6 keys
&trans          &trans     &trans     &trans     &trans     &trans
// Row 2 Right - 6 keys
&trans          &trans     &trans     &trans     &trans     &trans
// Row 3 - Thumb row
&trans          &trans     &trans     &trans     &trans
&trans          &trans     &trans
            >;
        };
    };
};
